{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Keep variables and secrets set in the Cloudflare dashboard (ADMIN_EMAIL, ACCESS_TEAM_DOMAIN, ACCESS_AUD)
  // when deploying from here. See README.md.
  "keep_vars": true,

  // The React app is served as static assets by this same Worker.
  // Only /api/* runs Worker code first; everything else is a static file or the SPA shell.
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lms-db",
      "database_id": "848b2f89-c242-4f72-a314-dfffdde1b8ae",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "lms-assets" }],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "22d48e3293d2496d881ef662ad96200e" }],

  // Weekly backup of the database to R2 (Sundays 03:00 UTC). See src/lib/backup.ts.
  "triggers": { "crons": ["0 3 * * SUN"] },

  // Workers AI for hints and explanations (docs/PLAN.md section 4b).
  "ai": { "binding": "AI" }
}
