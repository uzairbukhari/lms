// LOCAL DEVELOPMENT ONLY: identical to wrangler.jsonc but without the Workers AI binding, which has no
// local simulator and needs a Cloudflare API token even under `wrangler dev`. AI features fall back to the
// stored hints and explanations when env.AI is missing. Keep the two files in sync.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Keep variables and secrets set in the Cloudflare dashboard (ADMIN_EMAIL, ACCESS_TEAM_DOMAIN, ACCESS_AUD)
  // when deploying from here. See README.md.
  "keep_vars": true,

  // The React app is served as static assets by this same Worker.
  // Only /api/* runs Worker code first; everything else is a static file or the SPA shell.
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lms-db",
      "database_id": "848b2f89-c242-4f72-a314-dfffdde1b8ae",
      "migrations_dir": "../migrations",
      // Uses the production database, not a local copy.
      "remote": true
    }
  ],
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "lms-assets" }],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "22d48e3293d2496d881ef662ad96200e" }]
}
