   "type": "glossary",
   "terms": [
    {
     "term": "adjective",
     "meaning": "A describing word. It tells us more about a noun."
    },
    {
     "term": "plural",
     "meaning": "A word that means more than one, like cats."
    },
    {
     "term": "s",
     "meaning": "The letter we usually add to make a plural."
    },
    {
     "term": "es",
     "meaning": "The letters we add to make a plural when a word ends in s, x, ch or sh."
    },
    {
     "term": "joining word",
     "meaning": "A word that links two ideas, like and, but or because."
    },
    {
     "term": "and",
     "meaning": "A joining word that adds one idea to another."
    },
    {
     "term": "but",
     "meaning": "A joining word that shows a difference."
    },
    {
     "term": "because",
     "meaning": "A joining word that gives a reason."
    }
