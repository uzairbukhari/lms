    {
      "type": "glossary",
      "terms": [
        {
          "term": "check-in",
          "meaning": "A friendly game that shows us what you know. It is not a test."
        },
        {
          "term": "noun",
          "meaning": "A word that names a person, place or thing."
        },
        {
          "term": "verb",
          "meaning": "A word for an action or a state, like run or is."
        },
        {
          "term": "adjective",
          "meaning": "A word that describes a noun, like big or red."
        },
        {
          "term": "adverb",
          "meaning": "A word that tells how, when or where something happens, like quickly."
        },
        {
          "term": "capital letters",
          "meaning": "Big letters used at the start of sentences and names."
        },
        {
          "term": "comma",
          "meaning": "A small mark (,) that separates things in a list or pauses a sentence."
        },
        {
          "term": "speech marks",
          "meaning": "Marks (\" \") that go around the exact words someone says."
        },
        {
          "term": "apostrophe",
          "meaning": "A mark (') that shows missing letters, as in don't, or belonging, as in the dog's bone."
        },
        {
          "term": "tense",
          "meaning": "Tells us when something happens: past, present or future."
        },
        {
          "term": "prefix",
          "meaning": "A group of letters added to the start of a word to change its meaning."
        },
        {
          "term": "suffix",
          "meaning": "A group of letters added to the end of a word to change its meaning."
        },
        {
          "term": "synonym",
          "meaning": "A word that means almost the same as another word."
        },
        {
          "term": "antonym",
          "meaning": "A word that means the opposite of another word."
        }
      ]
    }
  ],
