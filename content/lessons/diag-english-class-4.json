              "x": 85,
              "y": 40,
              "size": 3
            }
          ]
        },
        {
          "caption": "Today I walk to school. That is the present.",
          "items": [
            {
              "emoji": "🚶",
              "x": 50,
              "y": 55,
              "id": "me",
              "size": 3,
              "anim": "bounce",
              "label": "walk (present)"
            },
            {
              "emoji": "🏫",
              "x": 85,
              "y": 40,
              "size": 3
            }
          ]
        },
        {
          "caption": "Tomorrow I will walk to school. That is the future.",
          "items": [
            {
