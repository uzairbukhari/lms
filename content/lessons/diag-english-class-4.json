       "y": 55,
       "size": 3,
       "anim": "none",
       "label": "past: walked"
      },
      {
       "id": "b",
       "emoji": "⬅️",
       "x": 20,
       "y": 20,
       "size": 2,
       "anim": "none"
      }
     ]
    },
    {
     "caption": "Today, I walk.",
     "items": [
      {
       "id": "a",
       "emoji": "🚶",
       "x": 50,
       "y": 55,
       "size": 3,
       "anim": "bounce",
       "label": "present: walk"
      }
     ]
    },
