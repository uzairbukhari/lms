    {
      "type": "glossary",
      "terms": [
        {
          "term": "check-in",
          "meaning": "A friendly game that shows us what you know. It is not a test."
        },
        {
          "term": "alphabet",
          "meaning": "All the letters we use for reading and writing. There are 26 of them."
        },
        {
          "term": "sound",
          "meaning": "What you hear when you say a letter, like sss for s."
        },
        {
          "term": "rhyme",
          "meaning": "Words that sound the same at the end, like cat and hat."
        },
        {
          "term": "sentence",
          "meaning": "Words that tell a whole idea. It starts with a capital letter and ends with a full stop."
        },
        {
          "term": "capital letter",
          "meaning": "A big letter, like T, used at the start of a sentence or a name."
        },
        {
          "term": "full stop",
          "meaning": "A little dot at the end of a sentence."
        },
        {
          "term": "noun",
          "meaning": "A naming word, like frog, ball or Mum."
        },
        {
          "term": "verb",
          "meaning": "An action word, like jump, run or eat."
        },
        {
          "term": "opposites",
          "meaning": "Words that mean the very opposite, like hot and cold."
        }
      ]
    }
  ],
