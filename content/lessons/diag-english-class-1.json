          "a",
          "b",
          "c",
          "d"
        ]
      }
    },
    {
      "type": "heading",
      "text": "Stop 4: Naming words and action words"
    },
    {
      "type": "text",
      "markdown": "A **noun** is a naming word, like frog, ball or Mum. A **verb** is an action word, like jump, run or eat."
    },
    {
      "type": "explainer",
      "title": "Noun and verb",
      "scenes": [
        {
          "caption": "This is a frog. Frog is a noun. It names something.",
          "items": [
            {
              "emoji": "🐸",
              "x": 30,
              "y": 55,
              "id": "frog",
              "size": 3,
              "label": "frog (noun)"
            }
          ]
        },
        {
          "caption": "Now the frog is doing something. Jump is a verb. It is an action word.",
          "items": [
            {
              "emoji": "🐸",
              "x": 70,
              "y": 35,
              "id": "frog",
              "size": 3,
              "anim": "bounce",
              "label": "jump (verb)"
            }
          ]
        }
      ]
    },
    {
      "type": "check",
      "question": {
        "type": "multiple_choice",
        "prompt": "Which one is an action word?",
        "ref": "c3",
        "skill_tag": "grammar.verbs",
        "options": [
          {
            "id": "a",
            "text": "table"
          },
          {
            "id": "b",
            "text": "jump"
          },
          {
            "id": "c",
            "text": "red"
          }
        ],
        "answer": [
          "b"
        ]
      }
    },
    {
      "type": "heading",
      "text": "Stop 5: Opposites"
    },
    {
      "type": "text",
      "markdown": "**Opposites** are words that mean the very opposite. Hot and cold are opposites."
    },
    {
      "type": "explainer",
      "title": "Opposites",
      "scenes": [
        {
          "caption": "The sun is hot.",
          "items": [
            {
              "emoji": "☀️",
              "x": 50,
              "y": 45,
              "id": "t1",
              "size": 3,
              "anim": "spin",
              "label": "hot"
            }
          ]
        },
        {
          "caption": "The snow is cold. Hot and cold are opposites!",
          "items": [
            {
              "emoji": "❄️",
              "x": 50,
              "y": 45,
              "id": "t1",
              "size": 3,
              "anim": "pulse",
              "label": "cold"
            }
          ]
        },
        {
          "caption": "An elephant is big. A mouse is small. Big and small are opposites too!",
          "items": [
            {
              "emoji": "🐘",
              "x": 30,
              "y": 50,
              "size": 3,
              "label": "big"
            },
            {
              "emoji": "🐭",
              "x": 75,
              "y": 60,
              "size": 1,
              "label": "small"
            }
          ]
        }
      ]
    },
