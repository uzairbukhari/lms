   "type": "glossary",
   "terms": [
    {
     "term": "check-in",
     "meaning": "A friendly game that shows us what you know. It is not a test."
    },
    {
     "term": "place value",
     "meaning": "The value of a digit depends on its place. In 4,825 the 8 is worth 800."
    },
    {
     "term": "round",
     "meaning": "To change a number to a nearby, easier one, like 3,742 to 3,700."
    },
    {
     "term": "estimate",
     "meaning": "A sensible guess that is close to the real answer."
    },
    {
     "term": "fact family",
     "meaning": "Multiplying and dividing facts that use the same three numbers."
    },
    {
     "term": "partition",
     "meaning": "To split a number into parts, like 34 into 30 and 4."
    },
    {
     "term": "carry",
     "meaning": "Moving a ten to the next column when a column adds up to 10 or more."
    },
    {
     "term": "borrow",
     "meaning": "Exchanging 1 ten for 10 ones so you can take away."
    },
    {
     "term": "fraction",
     "meaning": "A part of a whole, like 3/4."
    },
    {
     "term": "equivalent",
     "meaning": "Fractions that are the same amount, like 1/2 and 2/4."
    },
    {
     "term": "perimeter",
     "meaning": "The distance all the way around the edge of a shape."
    },
    {
     "term": "area",
