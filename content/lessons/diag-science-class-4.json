        },
        {
          "term": "melt",
          "meaning": "When a solid gets warm and turns into a liquid."
        },
        {
          "term": "magnet",
          "meaning": "An object that pulls iron and steel towards it."
        },
        {
          "term": "rain",
          "meaning": "Water drops that fall from clouds."
        },
