    {
     "term": "check-in",
     "meaning": "A friendly game that shows us what you know. It is not a test."
    },
    {
     "term": "solid",
     "meaning": "Matter that keeps its shape, like ice or wood."
    },
    {
     "term": "liquid",
     "meaning": "Matter that flows and takes the shape of its container, like water."
    },
    {
     "term": "gas",
     "meaning": "Matter that spreads out to fill all the space, like air or steam."
    },
    {
     "term": "melt",
     "meaning": "When a solid turns into a liquid because of heat."
    },
    {
     "term": "boil",
     "meaning": "When a liquid is heated so much that it turns into a gas quickly."
    },
    {
     "term": "freeze",
     "meaning": "When a liquid turns into a solid because it gets cold."
    },
    {
     "term": "evaporates",
     "meaning": "When a liquid slowly turns into a gas, like a puddle drying in the sun."
    },
    {
     "term": "condenses",
     "meaning": "When a gas cools and turns into a liquid, like vapour turning into cloud drops."
    },
    {
     "term": "producer",
     "meaning": "A plant that makes its own food using sunlight. A food chain starts with one."
    },
    {
     "term": "herbivores",
     "meaning": "Animals that eat only plants."
    },
    {
     "term": "carnivores",
     "meaning": "Animals that eat other animals."
    },
    {
     "term": "force",
     "meaning": "A push or a pull."
    },
    {
     "term": "friction",
     "meaning": "A force that slows things down when they rub together."
    },
    {
     "term": "gravity",
     "meaning": "A force that pulls things towards the Earth."
    },
    {
     "term": "magnet",
     "meaning": "An object that pulls some metals like iron towards it."
    },
    {
     "term": "shadows",
     "meaning": "Dark shapes made when an object blocks light."
    },
    {
     "term": "vibrations",
     "meaning": "Tiny, fast shakes. They make sounds."
    },
    {
     "term": "circuit",
     "meaning": "A complete loop for electricity, with a battery, wires and a bulb."
    }
   ]
  }
