{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learning Adventures",
  "version": "1.0.0",
  "identifier": "trade.sipwise.lms.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY_FROM_tauri_signer_generate",
      "endpoints": ["https://lms.sipwise.trade/api/desktop/update/{{target}}-{{arch}}/{{current_version}}"],
      "windows": { "installMode": "passive" }
    }
  }
}
