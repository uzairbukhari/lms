{
  "name": "lms",
  "private": true,
  "version": "0.0.0",
  "description": "A private learning platform for two kids (and their friends), built on Cloudflare.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @lms/web",
    "dev:worker": "npm run dev -w @lms/worker",
    "build": "npm run build -w @lms/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "deploy": "npm run build && npm run deploy -w @lms/worker"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
